# ============================================================
# Labour Market Intelligence Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# ---- DATABASE ----
DATABASE_URL="postgresql://user:password@localhost:5432/labour_market_intelligence"

# ---- AUTHENTICATION ----
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRY="24h"
SESSION_SECRET="change-this-to-another-secure-random-string"

# ---- LABOUR DEMAND: JOB POSTING APIs ----

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in"
ADZUNA_ENABLED="false"

# Jooble API (https://jooble.org/api/about)
JOOBLE_API_KEY=""
JOOBLE_ENABLED="false"

# ---- AI / LLM PROVIDER ----
# Provider: "openai" | "gemini" | "none"
AI_PROVIDER="none"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---- GOVERNMENT DATA SOURCES ----
# These require official authorization / data-sharing agreements

# NCS (National Career Service)
NCS_API_URL=""
NCS_API_KEY=""
NCS_ENABLED="false"

# e-Shram
ESHRAM_API_URL=""
ESHRAM_API_KEY=""
ESHRAM_ENABLED="false"

# ---- LEADING INDICATORS ----

# EPFO
EPFO_API_URL=""
EPFO_ENABLED="false"

# Udyam/MSME
UDYAM_API_URL=""
UDYAM_ENABLED="false"

# GeM (Government e-Marketplace)
GEM_API_URL=""
GEM_ENABLED="false"

# ---- APPLICATION ----
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ---- DATA PATHS ----
DATA_RAW_PATH="./data/raw"
DATA_PROCESSED_PATH="./data/processed"
DATA_REFERENCE_PATH="./data/reference"
DATA_GEOGRAPHY_PATH="./data/geography"

# ---- CONNECTORS ----
# Master toggle for synthetic/development data provider
SYNTHETIC_DATA_ENABLED="true"

# ---- INGESTION SCHEDULE ----
# Cron expressions for background ingestion jobs
INGESTION_CRON_DEMAND="0 */6 * * *"
INGESTION_CRON_INDICATORS="0 0 1 * *"
